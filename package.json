{
  "name": "mana-duel",
  "private": true,
  "version": "0.1.0",
  "description": "Minimalist mobile-first card game inspired by the rules of Magic: The Gathering. Fourteen decks, 1v1 against an AI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "LLM_LIVE=1 vitest run tests/llm/live.test.ts",
    "sim": "tsx scripts/sim.ts",
    "cards": "tsx scripts/cards.ts",
    "verify": "npm run lint && npm run knip && npm run typecheck && npm run test && npm run sim -- --games 196 --quiet && npm run build"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.118",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.20.4",
    "happy-dom": "^20.14.5",
    "knip": "^6.39.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
